{
  "name": "forge-flow",
  "version": "2.1.1",
  "description": "Forge Flow: engineering workflow for coding agents.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "agent-skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ff": "cli/ff.mjs"
  },
  "scripts": {
    "test": "node --test --test-timeout=120000 \"tests/*.test.mjs\""
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  }
}
